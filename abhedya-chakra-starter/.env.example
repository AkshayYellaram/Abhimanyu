ABHEDYA_DATA_DIR=./data
# Optional absolute path override:
# ABHEDYA_DB_PATH=D:/abhedya-data/abhedya.duckdb
# DuckDB resource bounds for a 16 GB evaluation laptop:
ABHEDYA_DUCKDB_MEMORY_LIMIT=12GB
ABHEDYA_DUCKDB_THREADS=4
# Optional scratch directory for spill-to-disk operations:
# ABHEDYA_DUCKDB_TEMP_DIR=D:/abhedya-data/duckdb_tmp
# Optional local-only AI case-diary summary:
ABHEDYA_LOCAL_LLM_MODEL=qwen3:4b
